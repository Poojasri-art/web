{
  "diff": true,
  "extension": ["js"],
  "package": "./package.json",
  "reporter": "mochawesome",
  "reporter-option": [
    "reportDir=reports/security-html",
    "reportFilename=Vulnerability_Test_Report",
    "quiet=false",
    "overwrite=true",
    "html=true",
    "json=true"
  ],
  "slow": 75,
  "spec": ["security-tests/**/*.test.js"],
  "timeout": 60000,
  "ui": "bdd",
  "recursive": true
}
